# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 前置/后置 LLM（Cast Sheet 分角 + 人设/配置终审）
LLM_CAST_PLANNER_MODEL=qwen3.7-plus
# 人设 LLM 终审轮次（默认 0=关闭，本地查重后可 opt-in）；打回重生成人数上限（默认 3）
LLM_PROFILE_REVIEW_ROUNDS=0
LLM_PROFILE_REVIEW_MAX_REGEN=3
# 本地 persona 相似度查重阈值（默认 0.60）
PROFILE_DEDUP_THRESHOLD=0.60
LLM_CONFIG_BATCH_WORKERS=3
LLM_RATE_LIMIT_RETRIES=3

# Zep 记忆图谱
ZEP_API_KEY=your_zep_api_key_here

# 进度总线：memory（默认）| redis（多 worker 时可选，本期仅配置位）
PROGRESS_BUS=memory
# 僵尸 TTL（秒）
# PROGRESS_TTL_BUILDING_SEC=7200
# PROGRESS_TTL_PREPARING_SEC=3600
# PROGRESS_JANITOR_INTERVAL_SEC=300
# Phase C：优雅退出（SIGTERM/Ctrl+C）时不杀模拟子进程，重启后 adopt
# SIM_DETACH_ON_EXIT=false

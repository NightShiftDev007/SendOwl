# Local development values. Replace both passwords before using this stack
# outside an isolated developer machine.
HOST_BIND=127.0.0.1
FRONTEND_PORT=3200
BACKEND_PORT=8210
APP_ENV=development

POSTGRES_DB=sendowl
POSTGRES_USER=sendowl
POSTGRES_PASSWORD=local-postgres-password-change-me
DATABASE_URL=postgresql://sendowl:local-postgres-password-change-me@postgres:5432/sendowl

# Isolated Compose-only PostgreSQL integration test database. It has no host
# port and uses tmpfs, so it cannot reuse or persist SendOwl application data.
TEST_POSTGRES_DB=sendowl_test
TEST_POSTGRES_USER=sendowl_test
TEST_POSTGRES_PASSWORD=local-test-postgres-password-change-me
TEST_POSTGRES_DATABASE_URL=postgresql://sendowl_test:local-test-postgres-password-change-me@postgres-test:5432/sendowl_test

REDIS_PASSWORD=local-redis-password-change-me
REDIS_URL=redis://:local-redis-password-change-me@redis:6379/0

# Optional AgendaScope refresh worker. These empty placeholders keep the default
# stack isolated and disabled. Put a dedicated read-only source DSN and its
# operator-verified identity in a separate gitignored env file, then explicitly
# start the `media-sync` Compose profile.
AGENDASCOPE_DATABASE_URL=
AGENDASCOPE_EXPECTED_DATABASE_NAME=
AGENDASCOPE_EXPECTED_SCHEMA_REVISION=
MEDIA_SYNC_INTERVAL_SECONDS=300
MEDIA_SYNC_WORKER_ID=sendowl-compose-media-sync-worker

# Leave all three empty to keep only the manual OASIS platform smoke ready.
# Semantic trials become ready only when all three explicit values are provided.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

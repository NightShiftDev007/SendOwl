# Local development values. Replace both passwords before using this stack
# outside an isolated developer machine.
HOST_BIND=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8010
APP_ENV=development

POSTGRES_DB=ai_decision_center
POSTGRES_USER=ai_decision_center
POSTGRES_PASSWORD=local-postgres-password-change-me
DATABASE_URL=postgresql://ai_decision_center:local-postgres-password-change-me@postgres:5432/ai_decision_center

REDIS_PASSWORD=local-redis-password-change-me
REDIS_URL=redis://:local-redis-password-change-me@redis:6379/0
